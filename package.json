{
  "name": "@joeljuca/pi-explabs",
  "version": "0.1.0",
  "description": "pi extension for Experiential Labs",
  "type": "module",
  "author": "Joel Jucá <joeljuca@proton.me> (https://joeljuca.com)",
  "repository": "joeljuca/pi-explabs",
  "homepage": "https://github.com/joeljuca/pi-explabs",
  "bugs": "https://github.com/joeljuca/pi-explabs/issues",
  "license": "Apache-2.0",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "experientiallabs",
    "explabs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "prettier:check": "prettier -c ./**/*.md ./**/*.ts",
    "prettier:fix": "prettier -w ./**/*.md ./**/*.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/debug": "^4.1.13",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
